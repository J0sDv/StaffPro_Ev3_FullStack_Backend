[Unit]
Description=StaffPro %i
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/staffpro/%i
EnvironmentFile=/etc/staffpro.env
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/staffpro/%i/%i.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target